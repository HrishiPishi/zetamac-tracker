{
  "manifest_version": 3,
  "name": "Zetamac Progress Tracker",
  "description": "Tracks Zetamac arithmetic scores, daily bests, plays per day, and improvement trends locally in your browser.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://arithmetic.zetamac.com/*",
    "http://arithmetic.zetamac.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arithmetic.zetamac.com/*",
        "http://arithmetic.zetamac.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Zetamac Tracker",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html"
}
